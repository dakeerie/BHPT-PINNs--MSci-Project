# HTCondor submit file for the warm-start multi-l PINN (PINNGBFWXWS.py). Needs gbf_reference.py and
# run_PINNGBFWXWS.sh in the same directory, and a logs/ directory.
#
# ONE job that trains l = 2, 3, 4 in sequence, lowest first. l = 2 starts cold; each later l is initialised from the
# previous l's trained network (curriculum off, Adam learning-rate schedule x warm_lr_scale, warm_adam_steps Adam steps).
# Output: GBFWXWSData/{timestamp}_M{mass}_x{x}_{run_tag}/l2, l3, l4 + multi_l_GBF.png + multi_l_GBF.csv
#
# Ansatz u = 1 + x E(x, omega)[P + e^{2 i omega r*} Q] (taylor_order = 0); envelope gate at 0.6 x the eikonal barrier-top
# frequency M*omega_c = (l + 1/2)/(3 sqrt 3) with exponent 4; 25% of every batch drawn uniformly in omega from
# 0.4 x M*omega_c upwards; log-uniform base sampling; curriculum over the first 30% of Adam (cold l only);
# omega*r/(1 + omega*r) third input; envelope-normalised residuals; pure physics loss (ODE + flux); 128-wide network.

executable = run_PINNGBFWXWS.sh

environment = "PINN_SCRIPT=PINNGBFWXWS.py GBF_BASIS_VERBOSE=0"

# -----------------------------
# Run parameters
# -----------------------------
mass = 0.5
modes = 2,3,4
x_extract = 0.99
omega_start = 2.6
omega_final = 0.01
query_steps = 1000
adam_steps = 40000
warm_adam_steps = 20000
warm_lr_scale = 0.2
lbfgs_steps = 1500
curriculum_start = 0.5
curriculum_begin = 0.0
curriculum_end = 0.3
omega_sampling = log_uniform
omega_hf_fraction = 0.25
omega_hf_band_start = 0.4
extra_input = omega_r
envelope_M_omega_b = 1e6
envelope_gate_fraction = 0.6
envelope_gate_exponent = 4
taylor_order = 0
res_norm = env
pi_ustar_scale = 56.0
seed = 0
run_numerical = no
run_tag = WS_T0_g06p4_hf25_128wide
extra_args =

arguments = "--mass $(mass) --modes $(modes) --x_extract $(x_extract) --omega_start $(omega_start) --omega_final $(omega_final) --query_steps $(query_steps) --adam_steps $(adam_steps) --warm_adam_steps $(warm_adam_steps) --warm_lr_scale $(warm_lr_scale) --lbfgs_steps $(lbfgs_steps) --curriculum_start $(curriculum_start) --curriculum_begin $(curriculum_begin) --curriculum_end $(curriculum_end) --omega_sampling $(omega_sampling) --omega_hf_fraction $(omega_hf_fraction) --omega_hf_band_start $(omega_hf_band_start) --extra_input $(extra_input) --envelope_M_omega_b $(envelope_M_omega_b) --envelope_gate_fraction $(envelope_gate_fraction) --envelope_gate_exponent $(envelope_gate_exponent) --taylor_order $(taylor_order) --res_norm $(res_norm) --pi_ustar_scale $(pi_ustar_scale) --seed $(seed) --run_numerical $(run_numerical) --run_tag $(run_tag) $(extra_args)"

getenv = True

request_gpus = 1
request_cpus = 1
request_memory = 8GB

should_transfer_files = NO

output = logs/PINNGBFWXWS.$(run_tag).$(ClusterId).out
error  = logs/PINNGBFWXWS.$(run_tag).$(ClusterId).err
log    = logs/PINNGBFWXWS.$(ClusterId).log

queue 1