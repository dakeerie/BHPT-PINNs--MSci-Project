# HTCondor submit file for PINNGBFWX.py (needs gbf_reference.py and run_PINNGBFWX_validation.sh in the same
# directory, and a logs/ directory).
#
# Three independent cold-start jobs, l = 2, 3, 4:
#   u = 1 + x E(x, omega)[P + e^{2 i omega r*} Q]  (taylor_order = 0), envelope gate disabled (M*omega_b = 1e6),
#   log-uniform omega sampling, curriculum over the first 30% of Adam, omega*r/(1 + omega*r) third input,
#   envelope-normalised residuals, pure physics loss (ODE + flux).

executable = run_PINNGBFWX_validation.sh

environment = "PINN_SCRIPT=PINNGBFWX.py GBF_BASIS_VERBOSE=0"

# -----------------------------
# Run parameters
# -----------------------------
mass = 0.5
x_extract = 0.99
omega_start = 2.6
omega_final = 0.01
query_steps = 200
adam_steps = 36000
lbfgs_steps = 500
curriculum_start = 0.5
curriculum_begin = 0.0
curriculum_end = 0.3
omega_sampling = log_uniform
extra_input = omega_r
envelope_M_omega_b = 1e6
taylor_order = 0
res_norm = env
pi_ustar_scale = 56.0
seed = 0
run_numerical = no
run_tag = T0_nogate_l$(mode)
extra_args =

arguments = "--mass $(mass) --mode $(mode) --x_extract $(x_extract) --omega_start $(omega_start) --omega_final $(omega_final) --query_steps $(query_steps) --adam_steps $(adam_steps) --lbfgs_steps $(lbfgs_steps) --curriculum_start $(curriculum_start) --curriculum_begin $(curriculum_begin) --curriculum_end $(curriculum_end) --omega_sampling $(omega_sampling) --extra_input $(extra_input) --envelope_M_omega_b $(envelope_M_omega_b) --taylor_order $(taylor_order) --res_norm $(res_norm) --pi_ustar_scale $(pi_ustar_scale) --seed $(seed) --run_numerical $(run_numerical) --run_tag $(run_tag) $(extra_args)"

getenv = True

request_gpus = 1
request_cpus = 1
request_memory = 8GB

should_transfer_files = NO

output = logs/PINNGBFWX.$(run_tag).$(ClusterId).$(ProcId).out
error  = logs/PINNGBFWX.$(run_tag).$(ClusterId).$(ProcId).err
log    = logs/PINNGBFWX.$(ClusterId).log

queue mode in (2, 3, 4)