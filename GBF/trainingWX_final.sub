# HTCondor submit file for PINNGBFWX.py (needs gbf_reference.py and run_PINNGBFWX_validation.sh in the same
# directory, and a logs/ directory).
#
# ONE production job on the optimal settings found in the A/B/C validation (configuration B):
#   B_final   log-uniform omega sampling, frequency curriculum over the first 30% of Adam,
#             omega*r/(1 + omega*r) third network input, envelope crossover M*omega_b = 0.3,
#             envelope-normalised residuals, pure physics loss (ODE + flux; the low-frequency loss has been removed).
# lbfgs_steps = 500: the L-BFGS loss plateaus after ~250 steps, so 500 leaves margin at a fraction of the cost.
# The basis-tracking summary is always printed at the end of the .out file and written to
# comparisons/basis_inward_integrations.csv; set GBF_BASIS_VERBOSE=1 below to also print every inward integration.

executable = run_PINNGBFWX_validation.sh

environment = "PINN_SCRIPT=PINNGBFWX.py GBF_BASIS_VERBOSE=0"

# -----------------------------
# Run parameters (configuration B)
# -----------------------------
mass = 0.5
mode = 2
x_extract = 0.99
omega_start = 1.2
omega_final = 0.01
query_steps = 200
adam_steps = 36000
lbfgs_steps = 500
curriculum_start = 0.5
curriculum_begin = 0.0
curriculum_end = 0.3
omega_sampling = log_uniform
extra_input = omega_r
envelope_M_omega_b = 0.3
res_norm = env
pi_ustar_scale = 56.0
seed = 0
run_numerical = no
run_tag = B_final
extra_args =

arguments = "--mass $(mass) --mode $(mode) --x_extract $(x_extract) --omega_start $(omega_start) --omega_final $(omega_final) --query_steps $(query_steps) --adam_steps $(adam_steps) --lbfgs_steps $(lbfgs_steps) --curriculum_start $(curriculum_start) --curriculum_begin $(curriculum_begin) --curriculum_end $(curriculum_end) --omega_sampling $(omega_sampling) --extra_input $(extra_input) --envelope_M_omega_b $(envelope_M_omega_b) --res_norm $(res_norm) --pi_ustar_scale $(pi_ustar_scale) --seed $(seed) --run_numerical $(run_numerical) --run_tag $(run_tag) $(extra_args)"

# Preserve the submitter environment.
getenv = True

request_gpus = 1
request_cpus = 1
request_memory = 8GB

# Assumes the project directory is on a shared filesystem.
should_transfer_files = NO

output = logs/PINNGBFWX.$(run_tag).$(ClusterId).$(ProcId).out
error  = logs/PINNGBFWX.$(run_tag).$(ClusterId).$(ProcId).err
log    = logs/PINNGBFWX.$(ClusterId).log

queue 1
